# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Meta XR plugin 1.205.0 (Meta Platforms, from Fab) is committed so every clone builds, and so
# sessions without the plugin installed can read its headers. This repo must stay private: parts of
# the plugin are under the Oculus SDK License. Its prebuilt third-party libraries would be dropped
# by the *.dll / *.lib / *.so rules above, which would leave a clone that cannot link.
!Plugins/MetaXR/Source/Thirdparty/**/*.dll
!Plugins/MetaXR/Source/Thirdparty/**/*.lib
!Plugins/MetaXR/Source/Thirdparty/**/*.so

# Meta Interaction SDK 1.205.0 (MetaXRInteraction), committed for the same reasons and under the same
# license. Its folder is spelled "ThirdParty", not "Thirdparty" as in MetaXR.
!Plugins/MetaXRInteraction/Source/ThirdParty/**/*.dll
!Plugins/MetaXRInteraction/Source/ThirdParty/**/*.lib
!Plugins/MetaXRInteraction/Source/ThirdParty/**/*.so

# Meta ISDK samples (OculusInteractionSamples) are a local reference and the HandPoseStudio recording
# tool only. vBoR must not depend on them at runtime: its parts are built in C++ on ISDK directly, and
# recorded hand poses are saved under the project's Content/, never under the samples plugin.
Plugins/OculusInteractionSamples/

# Current handoff between Claude Code (spec/review) and the Codex desktop app (implementation).
# Volatile state (branch, commit, what to do now); durable records live in Docs/Specs and Docs/Reviews.
/HANDOFF.md
